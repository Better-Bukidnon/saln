{
  "name": "saln-bukidnon",
  "private": true,
  "version": "0.4.1",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "release:patch": "npm version patch --no-git-tag-version",
    "release:minor": "npm version minor --no-git-tag-version",
    "release:major": "npm version major --no-git-tag-version",
    "dev:demo": "vite --mode demo --port 5199 --strictPort",
    "build": "tsc --noEmit && vite build",
    "validate-data": "tsx scripts/validate-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "e2e": "playwright test",
    "smoke": "playwright test --project smoke",
    "e2e:fixture": "playwright test --project chromium",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@animate-ui/react": "^2.4.2",
    "@fontsource-variable/figtree": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "motion": "^14.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "recharts": "3.8.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.156.1",
    "yaml": "^2.9.1"
  }
}
